  "schema_version": "0.1",
  "knowledge_version": "us-2025-core-knowledge-v0.1",
  "tax_year": 2025,
  "jurisdiction": "US",
  "items": [
    {
      "knowledge_id": "us_2025_additional_medicare_tax",
      "topic": "additional_medicare_tax",
      "summary": "Additional Medicare Tax applies at 0.9% above filing-status thresholds. Employers withhold it on wages paid over $200,000 without regard to filing status.",
      "trigger_conditions": {
        "wages_or_self_employment_income_over": {
          "single": 200000,
          "head_of_household": 200000,
          "married_filing_jointly": 250000,
          "married_filing_separately": 125000
        }
      },
      "source_ids": ["irs_topic_560", "irs_topic_751"],
      "status": "effective"
    },
    {
      "knowledge_id": "us_2025_feie_physical_presence",
      "topic": "foreign_earned_income_exclusion",
      "summary": "For 2025, the maximum foreign earned income exclusion is $130,000 per qualifying person. The physical presence test generally requires 330 full days in a foreign country during a 12-month period.",
      "trigger_conditions": {
        "foreign_earned_income_present": true,
        "days_abroad_less_than": 330
      },
      "source_ids": ["irs_feie_figuring_exclusion", "irs_i2555_2025"],
      "status": "effective"
    },
    {
      "knowledge_id": "us_2025_ca_sales_tax_nexus",
      "topic": "sales_tax_nexus",
      "jurisdiction": "CA",
      "summary": "California economic nexus generally applies when sales of tangible merchandise for delivery in California exceed $500,000 in the preceding or current calendar year.",
      "trigger_conditions": {
        "state": "CA",
        "sales_amount_over": 500000
      },
      "source_ids": ["ca_marketplace_facilitator_act", "ca_wayfair_general_information"],
      "status": "effective"
    },
    {
      "knowledge_id": "us_2025_ny_sales_tax_nexus",
      "topic": "sales_tax_nexus",
      "jurisdiction": "NY",
      "summary": "New York sales tax registration is required when the prior four sales tax quarters exceed both $500,000 in gross receipts and more than 100 sales transactions into New York.",
      "trigger_conditions": {
        "state": "NY",
        "sales_amount_over": 500000,
        "transactions_over": 100
      },
      "source_ids": ["ny_sales_tax_nexus"],
      "status": "effective"
    },
    {
      "knowledge_id": "us_2025_fl_no_personal_income_tax",
      "topic": "state_income_tax",
      "jurisdiction": "FL",
      "summary": "Florida does not impose a personal income tax, so there are no Florida personal income tax filing requirements.",
      "trigger_conditions": {
        "state": "FL"
      },
      "source_ids": ["fl_personal_income_tax_faq"],
      "status": "effective"
    }
  ]
}
